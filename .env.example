OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini

# Indexing
PDF_PARSER=docling
EMBEDDING_BACKEND=huggingface
HF_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
VECTOR_BACKEND=chroma
COLLECTION_NAME=uk_macro_policy

# Optional: faster PDF pass (HTML still uses Docling)
# PDF_PARSER=pymupdf4llm

# OCR is off by default — BoE/ONS/gov.uk PDFs already have a text layer.
# RapidOCR empty-result warnings are chart images, not missing prose.
# DOCLING_DO_OCR=1

# Optional: OpenAI embeddings instead of local BGE
# EMBEDDING_BACKEND=openai
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
